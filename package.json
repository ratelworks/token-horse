{
  "name": "token-horse",
  "version": "0.3.0",
  "description": "Token-consumption-reactive horse pet for Claude Code — as a mod above the prompt or in the statusline.",
  "type": "module",
  "bin": {
    "token-horse": "horse-token-runner.mjs"
  },
  "files": [
    "horse-token-runner.mjs",
    "horse-core.mjs",
    "horse-core.d.mts",
    "render-horse-preview.mjs",
    "horse-preview.gif",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node horse-token-runner.mjs",
    "demo": "node horse-token-runner.mjs",
    "preview": "node render-horse-preview.mjs",
    "statusline:sample": "printf '{\"tokensPerSecond\":4500}' | node horse-token-runner.mjs --statusline",
    "build": "node --check horse-token-runner.mjs && node --check horse-core.mjs && node --check render-horse-preview.mjs",
    "typecheck": "npm run build",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:oss-hygiene": "node scripts/check-oss-hygiene.mjs",
    "check": "npm run build && npm test && npm run check:oss-hygiene",
    "prepublishOnly": "npm run check",
    "check:mod": "claude plugin validate . && claude plugin test ."
  },
  "keywords": [
    "cli",
    "statusline",
    "claude-code",
    "token-usage",
    "terminal-pet",
    "claude-code-plugin",
    "claude-code-mod"
  ],
  "author": {
    "name": "Ratelworks Inc.",
    "email": "alphamale@ratelworks.co.kr",
    "url": "https://ratelworks.co.kr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratelworks/token-horse.git"
  },
  "bugs": {
    "url": "https://github.com/ratelworks/token-horse/issues"
  },
  "homepage": "https://github.com/ratelworks/token-horse#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
